# Cloudflare API token (scoped, Bearer auth) used by the cloudflare:* commands.
# Needs Zone:Read and SSL and Certificates:Read on the relevant zones.
CLOUDFLARE_API_TOKEN=

# Openprovider API credentials used by the openprovider:* commands.
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=
# Nameserver group applied by openprovider:reset-nameservers when --group is omitted.
OPENPROVIDER_DEFAULT_NS_GROUP=sitepilot-net
